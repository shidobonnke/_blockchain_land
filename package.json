{
  "name": "anagu-land-registry",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.3.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @anagu/shared && npm run build -w @anagu/contracts && npm run build -w @anagu/api && npm run build -w @anagu/web && npm run typecheck -w @anagu/mobile",
    "test": "npm run test -w @anagu/contracts && npm run test -w @anagu/api",
    "dev:api": "npm run start:dev -w @anagu/api",
    "dev:web": "npm run dev -w @anagu/web",
    "dev:mobile": "npm run start -w @anagu/mobile",
    "db:generate": "npm run prisma:generate -w @anagu/api",
    "db:migrate": "npm run prisma:migrate -w @anagu/api",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "evaluate": "node scripts/evaluate.mjs",
    "evaluate:30": "EVALUATION_SAMPLES=30 node scripts/evaluate.mjs",
    "evaluate:guide": "EVALUATION_SAMPLES=30 node scripts/evaluate-guide.mjs",
    "evaluate:csv": "node scripts/export-results-csv.mjs",
    "evaluate:pdf": "node scripts/export-report-pdf.mjs",
    "evaluate:all": "npm run evaluate:guide && npm run evaluate:csv && npm run evaluate:pdf",
    "format": "prettier --write \"apps/**/*.{ts,tsx,js,json}\" \"packages/**/*.{ts,tsx,js,json}\" \"scripts/**/*.{js,mjs}\" \"*.{json,md,yml}\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,js,json}\" \"packages/**/*.{ts,tsx,js,json}\" \"scripts/**/*.{js,mjs}\" \"*.{json,md,yml}\" \"docs/**/*.md\""
  },
  "engines": {
    "node": ">=20"
  }
}
